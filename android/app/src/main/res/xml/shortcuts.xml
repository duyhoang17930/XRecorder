<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut android:shortcutId="edit_video" android:enabled="true"
        android:icon="@mipmap/ic_launcher" android:shortcutShortLabel="@string/shortcut_video">
        <intent android:action="android.intent.action.VIEW"
            android:targetPackage="com.xrecorder.xrecorder"
            android:targetClass="com.xrecorder.xrecorder.MainActivity"
            android:data="xrecorder://app/editor" />
    </shortcut>
    <shortcut android:shortcutId="edit_photo" android:enabled="true"
        android:icon="@mipmap/ic_launcher" android:shortcutShortLabel="@string/shortcut_photo">
        <intent android:action="android.intent.action.VIEW"
            android:targetPackage="com.xrecorder.xrecorder"
            android:targetClass="com.xrecorder.xrecorder.MainActivity"
            android:data="xrecorder://app/photos" />
    </shortcut>
</shortcuts>
